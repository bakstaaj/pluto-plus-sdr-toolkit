<Window x:Class="PlutoGuiStarter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pluto+ SDR Session Runner"
        Height="880"
        Width="1260"
        MinHeight="740"
        MinWidth="1060">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Project folder:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Name="ProjectFolderTextBox" Margin="0,0,8,8"/>
                <Button Grid.Row="0" Grid.Column="4" Content="Browse..." Margin="0,0,8,8" Click="BrowseProjectFolder_Click"/>
                <Button Grid.Row="0" Grid.Column="5" Content="Open Folder" Margin="0,0,0,8" Click="OpenProjectFolder_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Config profile:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="ConfigComboBox" Margin="0,0,8,8" SelectionChanged="ConfigComboBox_SelectionChanged"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Refresh" Margin="0,0,8,8" Click="RefreshConfigs_Click"/>
                <Button Grid.Row="1" Grid.Column="3" Content="Edit Config" Margin="0,0,8,8" Click="EditConfig_Click"/>
                <Button Grid.Row="1" Grid.Column="4" Content="Open Report" Margin="0,0,8,8" Click="OpenReport_Click"/>
                <Button Grid.Row="1" Grid.Column="5" Content="Load Summary" Margin="0,0,0,8" Click="LoadSummary_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Run options:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5">
                    <TextBlock Text="Cycles" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Name="CyclesTextBox" Text="20" Width="55" Margin="0,0,12,0"/>

                    <TextBlock Text="Out prefix" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Name="OutPrefixTextBox" Width="120" Margin="0,0,12,0"/>

                    <TextBlock Text="Gain dB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Name="GainDbTextBox" Width="55" Margin="0,0,12,0"/>

                    <CheckBox Name="DryRunCheckBox" Content="Dry run" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <CheckBox Name="OpenReportAfterRunCheckBox" Content="Open report after run" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Extra" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Name="ExtraArgsTextBox" Width="300" Margin="0,0,12,0"/>

                    <Button Name="RunButton" Content="Run" Width="90" Margin="0,0,8,0" Click="RunButton_Click"/>
                    <Button Name="StopButton" Content="Stop" Width="90" IsEnabled="False" Click="StopButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Run Output">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Live output">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Clear" Width="85" Margin="0,0,8,0" Click="ClearOutput_Click"/>
                                <Button Content="Copy" Width="85" Click="CopyOutput_Click"/>
                            </StackPanel>
                            <TextBox Name="OutputTextBox" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" AcceptsReturn="True"/>
                        </DockPanel>
                    </GroupBox>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"/>

                    <GroupBox Grid.Column="2" Header="Summary CSV">
                        <DataGrid Name="SummaryDataGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Reports">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh Reports" Width="130" Margin="0,0,8,0" Click="RefreshReports_Click"/>
                        <Button Content="Open Selected" Width="130" Margin="0,0,8,0" Click="OpenSelectedReport_Click"/>
                        <Button Content="Open Latest" Width="110" Click="OpenLatestReport_Click"/>
                    </StackPanel>
                    <ListView Grid.Row="1" Name="ReportsListView" MouseDoubleClick="ReportsListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Report" Width="260" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Modified" Width="170" DisplayMemberBinding="{Binding Modified}"/>
                                <GridViewColumn Header="Size KB" Width="90" DisplayMemberBinding="{Binding SizeKb}"/>
                                <GridViewColumn Header="Path" Width="560" DisplayMemberBinding="{Binding FullPath}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Profile Preview">
                <TextBox Margin="8" Name="ConfigPreviewTextBox" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem><TextBlock Name="StatusTextBlock" Text="Ready"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
